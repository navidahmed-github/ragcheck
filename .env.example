# Embedding provider: local (default, deterministic, no key) | openai
EMBEDDER=local
# OPENAI_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536

# Vector store: memory (default, zero infra) | pgvector (docker compose up -d)
STORE=memory
